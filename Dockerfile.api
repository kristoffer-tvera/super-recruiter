FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine@sha256:cc02b814237a76c4735fb6eeee87181597b5e56f2ce458a435e527674d91f4d7 AS build

WORKDIR /src
COPY SuperRecruiter.Shared/SuperRecruiter.Shared.csproj SuperRecruiter.Shared/
COPY SuperRecruiter.Api/SuperRecruiter.Api.csproj SuperRecruiter.Api/
RUN dotnet restore SuperRecruiter.Api/SuperRecruiter.Api.csproj
COPY SuperRecruiter.Shared/ SuperRecruiter.Shared/
COPY SuperRecruiter.Api/ SuperRecruiter.Api/
RUN dotnet publish SuperRecruiter.Api/SuperRecruiter.Api.csproj --configuration Release --no-restore --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine@sha256:486297ae006e95ee2ee3112a2c03e3d26e41fbbc64b7a29e28e7a18cc36b12bb

RUN apk add --no-cache curl
WORKDIR /app
COPY --from=build --chown=1654:1654 /app/publish/ ./

USER 1654:1654
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=20s CMD curl --fail --silent --show-error --max-time 3 --header "Host: recruitment.amusedtodeath.eu" http://127.0.0.1:8080/api/live || exit 1
ENTRYPOINT ["dotnet", "SuperRecruiter.Api.dll"]